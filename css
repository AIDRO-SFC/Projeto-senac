body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    background-color: #f4f4f4;
}

header {
    background-color: #8b0000;
    color: white;
    padding: 20px;
    text-align: center;
}

nav {
    background-color: #b22222;
    padding: 10px;
    text-align: center;
}

nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

.container {
    padding: 20px;
}

h2 {
    color: #8b0000;
}

.produtos {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.produto {
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 5px;
    width: 250px;
    padding: 15px;
    text-align: center;
}

.produto img {
    width: 100%;
    height: 150px;
    object-fit: cover;
}

.preco {
    color: green;
    font-size: 18px;
    font-weight: bold;
}

button {
    background-color: #8b0000;
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
    border-radius: 4px;
}

button:hover {
    background-color: #a40000;
}